{
  "name": "braindrop",
  "version": "1.0.0",
  "author": "Cyril Deschamps <contact@cyrildeschamps.fr>",
  "description": "Mobile app for BrainDrop",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo run:android",
    "android:clean": "rm -rf node_modules/react-native-filament/android/.cxx && expo prebuild --clean && expo run:android",
    "ios": "expo run:ios",
    "ios:clean": "expo prebuild --clean && expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint-check": "npm-run-all --parallel \"lint-check:*\"",
    "lint-check:react": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint-check:typing": "tsc --noEmit",
    "lint-check:prettier": "prettier --check src",
    "lint-fix": "npm-run-all --parallel lint-fix:* lint-check:typing",
    "lint-fix:react": "eslint . --ext ts,tsx --report-unused-disable-directives --fix",
    "lint-fix:prettier": "prettier --write src"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@quidone/react-native-wheel-picker": "^1.4.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-google-signin/google-signin": "^13.2.0",
    "@sentry/react-native": "~6.10.0",
    "@tanstack/react-query": "^5.67.2",
    "axios": "^1.2.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "class-transformer": "^0.5.1",
    "date-fns": "^4.1.0",
    "expo": "~52.0.47",
    "expo-apple-authentication": "~7.1.3",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.4",
    "expo-gl": "~15.0.5",
    "expo-haptics": "~14.0.1",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.21",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "jwt-decode": "^4.0.0",
    "react": "18.3.1",
    "react-hook-form": "^7.55.0",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-logs": "^5.3.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-toast-message": "^2.2.1",
    "reflect-metadata": "^0.2.2",
    "superjson": "^2.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@types/react": "^18.2.79",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "commitizen": "^4.2.6",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^8.0.2",
    "jest": "^29.3.1",
    "jest-expo": "~52.0.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.1",
    "typescript": "^5.3.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "date-fns",
          "class-transformer",
          "reflect-metadata",
          "superjson",
          "jwt-decode"
        ]
      }
    }
  }
}
