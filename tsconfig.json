{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@ui": ["src/core/ui"],
      "@ui/*": ["src/core/ui/*"]
    }
  },
  "include": [
    "src",
    "components",
    "types",
    "**.ts",
    "**.js",
    "**.cjs",
    "app",
    "eslint.config.mjs",
    "db",
    "shims"
  ],
  "exclude": ["node_modules", "android", "ios"]
}
